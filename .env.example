# Copie para .env. Os valores abaixo servem apenas para desenvolvimento local.
DATABASE_URL="postgresql://finpilot:finpilot@localhost:5432/finpilot"
APP_URL="http://localhost:3000"

# Modo demonstração: habilita o botão "Entrar na demonstração" (usuário fictício criado pelo seed).
DEMO_MODE_ENABLED="true"

# E-mail: "file" grava as mensagens em .dev-mail/ (somente desenvolvimento).
# Em produção é necessário implementar um provedor real; sem ele, o envio falha de forma explícita.
EMAIL_PROVIDER="file"

# IA opcional. Sem chave, o assistente usa apenas o motor determinístico.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5-5"
