generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AccountType {
  CHECKING
  SAVINGS
  CASH
}

enum CategoryType {
  INCOME
  EXPENSE
}

/// REFUND aumenta o saldo e abate despesa da categoria, sem contar como receita.
enum TransactionType {
  INCOME
  EXPENSE
  REFUND
  TRANSFER_OUT
  TRANSFER_IN
}

enum TransactionStatus {
  PENDING
  POSTED
  CANCELED
}

enum TransactionSource {
  MANUAL
  CSV
  OPEN_FINANCE
  RECURRENCE
}

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum BudgetAlertLevel {
  WARNING_80
  REACHED_100
  EXCEEDED
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum Cadence {
  WEEKLY
  MONTHLY
  YEARLY
}

enum ConsentPurpose {
  TERMS
  PRIVACY_POLICY
  AI_PROCESSING
}

enum RuleMatchType {
  CONTAINS
  STARTS_WITH
  EQUALS
}

model User {
  id                     String    @id @default(cuid())
  name                   String
  email                  String    @unique
  passwordHash           String
  emailVerifiedAt        DateTime?
  locale                 String    @default("pt-BR")
  timezone               String    @default("America/Sao_Paulo")
  currency               String    @default("BRL")
  financialMonthStartDay Int       @default(1)
  estimatedIncomeCents   BigInt?
  minReserveCents        BigInt?
  onboardedAt            DateTime?
  isDemo                 Boolean   @default(false)
  aiEnabled              Boolean   @default(false)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  sessions      Session[]
  authTokens    AuthToken[]
  accounts      Account[]
  categories    Category[]
  transactions  Transaction[]
  transfers     Transfer[]
  budgets       Budget[]
  budgetAlerts  BudgetAlert[]
  goals         Goal[]
  contributions GoalContribution[]
  recurrences   RecurrenceRule[]
  importBatches ImportBatch[]
  categoryRules CategoryRule[]
  insights      Insight[]
  consents      Consent[]
  auditEvents   AuditEvent[]
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  userAgent  String?
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

model RateLimitBucket {
  key     String   @id
  count   Int
  resetAt DateTime
}

model Account {
  id                  String      @id @default(cuid())
  userId              String
  name                String
  type                AccountType
  institution         String?
  openingBalanceCents BigInt      @default(0)
  currency            String      @default("BRL")
  color               String?
  archivedAt          DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  user                User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactions  Transaction[]
  transfersFrom Transfer[]       @relation("TransferFrom")
  transfersTo   Transfer[]       @relation("TransferTo")
  recurrences   RecurrenceRule[]
  importBatches ImportBatch[]

  @@index([userId, archivedAt])
}

/// userId nulo indica categoria padrão, compartilhada e somente leitura.
model Category {
  id        String       @id @default(cuid())
  userId    String?
  name      String
  type      CategoryType
  icon      String?
  color     String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  user      User?        @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactions Transaction[]
  budgets      Budget[]
  rules        CategoryRule[]
  recurrences  RecurrenceRule[]

  @@unique([userId, name, type])
  @@index([userId])
}

model Transaction {
  id                   String            @id @default(cuid())
  userId               String
  accountId            String
  categoryId           String?
  type                 TransactionType
  amountCents          BigInt
  description          String
  transactionDate      DateTime          @db.Date
  status               TransactionStatus @default(POSTED)
  source               TransactionSource @default(MANUAL)
  externalId           String?
  dedupeHash           String?
  importBatchId        String?
  transferId           String?
  recurrenceRuleId     String?
  occurrenceDate       DateTime?         @db.Date
  isOccurrenceOverride Boolean           @default(false)
  notes                String?
  tags                 String[]          @default([])
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  account        Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category       Category?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  transfer       Transfer?          @relation(fields: [transferId], references: [id], onDelete: Cascade)
  importBatch    ImportBatch?       @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  recurrenceRule RecurrenceRule?    @relation(fields: [recurrenceRuleId], references: [id], onDelete: SetNull)
  contributions  GoalContribution[]

  @@unique([recurrenceRuleId, occurrenceDate])
  @@index([userId, transactionDate, id])
  @@index([userId, accountId, transactionDate])
  @@index([userId, categoryId, transactionDate])
  @@index([userId, dedupeHash])
  @@index([transferId])
}

model Transfer {
  id            String   @id @default(cuid())
  userId        String
  fromAccountId String
  toAccountId   String
  amountCents   BigInt
  transferDate  DateTime @db.Date
  description   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromAccount Account       @relation("TransferFrom", fields: [fromAccountId], references: [id], onDelete: Cascade)
  toAccount   Account       @relation("TransferTo", fields: [toAccountId], references: [id], onDelete: Cascade)
  legs        Transaction[]

  @@index([userId, transferDate])
}

model Budget {
  id         String   @id @default(cuid())
  userId     String
  categoryId String
  year       Int
  month      Int
  limitCents BigInt
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  alerts   BudgetAlert[]

  @@unique([userId, categoryId, year, month])
  @@index([userId, year, month])
}

model BudgetAlert {
  id        String           @id @default(cuid())
  userId    String
  budgetId  String
  level     BudgetAlertLevel
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  budget Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@unique([budgetId, level])
  @@index([userId, readAt])
}

model Goal {
  id           String     @id @default(cuid())
  userId       String
  title        String
  description  String?
  targetCents  BigInt
  initialCents BigInt     @default(0)
  dueDate      DateTime?  @db.Date
  priority     Int        @default(2)
  status       GoalStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  contributions GoalContribution[]

  @@index([userId, status])
}

/// amountCents pode ser negativo (retirada virtual). É alocação virtual, não movimenta saldo.
model GoalContribution {
  id                  String   @id @default(cuid())
  userId              String
  goalId              String
  amountCents         BigInt
  contributionDate    DateTime @db.Date
  note                String?
  linkedTransactionId String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal              Goal         @relation(fields: [goalId], references: [id], onDelete: Cascade)
  linkedTransaction Transaction? @relation(fields: [linkedTransactionId], references: [id], onDelete: SetNull)

  @@index([userId, goalId, contributionDate])
}

model RecurrenceRule {
  id          String          @id @default(cuid())
  userId      String
  accountId   String
  categoryId  String?
  type        TransactionType
  amountCents BigInt
  description String
  notes       String?
  tags        String[]        @default([])
  cadence     Cadence
  startDate   DateTime        @db.Date
  endDate     DateTime?       @db.Date
  nextRunAt   DateTime        @db.Date
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  account      Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category     Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  transactions Transaction[]

  @@index([userId, active, nextRunAt])
}

model ImportBatch {
  id             String   @id @default(cuid())
  userId         String
  accountId      String
  filename       String
  checksum       String
  status         String   @default("COMMITTED")
  importedCount  Int      @default(0)
  skippedCount   Int      @default(0)
  duplicateCount Int      @default(0)
  errorCount     Int      @default(0)
  createdAt      DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  account      Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId, accountId, checksum])
}

model CategoryRule {
  id         String        @id @default(cuid())
  userId     String
  matchType  RuleMatchType @default(CONTAINS)
  pattern    String
  categoryId String
  priority   Int           @default(100)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([userId, priority])
}

model Insight {
  id        String    @id @default(cuid())
  userId    String
  type      String
  period    String
  dedupeKey String
  payload   Json
  readAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, period])
}

model Consent {
  id        String         @id @default(cuid())
  userId    String
  purpose   ConsentPurpose
  version   String
  grantedAt DateTime       @default(now())
  revokedAt DateTime?
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

model AuditEvent {
  id         String   @id @default(cuid())
  userId     String
  action     String
  entityType String
  entityId   String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
